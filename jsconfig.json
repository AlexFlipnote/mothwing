{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "strict": true,
    "types": ["node"],
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": ["src", "bin", "test"],
  "exclude": ["test/fixture/src/js", "test/fixture/dist", "test/fixture/dist-bare", "test/fixture/dist-dev"]
}
